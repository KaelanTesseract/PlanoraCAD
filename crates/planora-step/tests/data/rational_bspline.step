  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))REPRESENTATION_CONTEXT('',''));
/* ===== Viertelzylinder: x >= 0, y >= 0, x*x + y*y <= 100, 0 <= z <= 5 ===== */
#20=MANIFOLD_SOLID_BREP('Viertelzylinder',#21);
#21=CLOSED_SHELL('',(#601,#602,#603,#604,#605));
/* Boden (Normale +z, Außenseite -z) */
#601=ADVANCED_FACE('',(#611),#621,.F.);
