/* ===== Flansch: Prisma h 8 über einer geschlossenen gleichförmigen kubischen B-Spline-Kurve
   (8 Kontrollpunkte, die ersten drei am Ende wiederholt; Knoten -3 ... 11, ungeklemmt) ===== */
#30=MANIFOLD_SOLID_BREP('Flansch',#31);
#31=CLOSED_SHELL('',(#1601,#1602,#1603));
/* Boden: Außenseite -z */
#1601=ADVANCED_FACE('',(#1611),#1621,.F.);
#1611=FACE_OUTER_BOUND('',#1631,.T.);
#1631=EDGE_LOOP('',(#1701));
#1701=ORIENTED_EDGE('',*,*,#1561,.F.);
/* Deckel: Rand ist die ungeklemmte periodische Kurve als UNIFORM_CURVE */
