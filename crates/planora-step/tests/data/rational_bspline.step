#1563=EDGE_CURVE('',#1511,#1512,#1551,.T.);
/* untere Kurve als zusammengesetzter Eintrag, obere als einfacher UNIFORM_CURVE */
#1581=(BOUNDED_CURVE()B_SPLINE_CURVE(3,(#1400,#1401,#1402,#1403,#1404,#1405,#1406,#1407,
  #1400,#1401,#1402),.UNSPECIFIED.,.T.,.F.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()
