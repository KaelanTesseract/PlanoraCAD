#1612=FACE_OUTER_BOUND('',#1632,.T.);
#1632=EDGE_LOOP('',(#1702));
#1702=ORIENTED_EDGE('',*,*,#1562,.T.);
/* Mantel: Strangfläche der unteren Kurve entlang +z, Naht bei (18; 0) */
